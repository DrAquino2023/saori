<!-- ========================================
     SISTEMA DE RESERVAS SAORI - COMPLETO
     ======================================== -->

<!-- Modal de Reservas -->
<div id="reservaModal" class="reserva-modal">
    <div class="reserva-container">
        <!-- Header -->
        <div class="reserva-header">
            <h2>Reservar Turno</h2>
            <button id="closeModal" class="close-btn">&times;</button>
        </div>

        <!-- Pasos del proceso -->
        <div class="reserva-steps">
            <div class="step active" data-step="1">
                <span class="step-number">1</span>
                <span>Servicio</span>
            </div>
            <div class="step" data-step="2">
                <span class="step-number">2</span>
                <span>Fecha & Hora</span>
            </div>
            <div class="step" data-step="3">
                <span class="step-number">3</span>
                <span>Datos</span>
            </div>
            <div class="step" data-step="4">
                <span class="step-number">4</span>
                <span>Pago</span>
            </div>
        </div>

        <!-- Contenido del modal -->
        <div class="reserva-content">
            
            <!-- PASO 1: Selección de Servicio -->
            <div id="step1" class="step-content active">
                <h3>Selecciona tu tratamiento</h3>
                <div class="servicios-grid">
                    <!-- Se cargan dinámicamente desde JavaScript -->
                </div>
                <div class="step-actions">
                    <button id="nextStep1" class="btn-next" disabled>Continuar</button>
                </div>
            </div>

            <!-- PASO 2: Calendario -->
            <div id="step2" class="step-content">
                <h3>Elige fecha y horario</h3>
                
                <!-- Selector de mes/año -->
                <div class="calendar-nav">
                    <button id="prevMonth" class="nav-btn">&lt;</button>
                    <h4 id="currentMonth"></h4>
                    <button id="nextMonth" class="nav-btn">&gt;</button>
                </div>

                <!-- Calendario -->
                <div id="calendar" class="calendar-grid">
                    <!-- Se genera dinámicamente -->
                </div>

                <!-- Horarios disponibles -->
                <div id="timeSlots" class="time-slots">
                    <h4>Horarios disponibles</h4>
                    <div id="availableSlots" class="slots-grid">
                        <!-- Se cargan dinámicamente -->
                    </div>
                </div>

                <div class="step-actions">
                    <button id="prevStep2" class="btn-prev">Anterior</button>
                    <button id="nextStep2" class="btn-next" disabled>Continuar</button>
                </div>
            </div>

            <!-- PASO 3: Datos del Cliente -->
            <div id="step3" class="step-content">
                <h3>Tus datos</h3>
                <form id="clientForm" class="client-form">
                    <div class="form-group">
                        <label for="nombre">Nombre completo *</label>
                        <input type="text" id="nombre" name="nombre" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="telefono">Teléfono *</label>
                        <input type="tel" id="telefono" name="telefono" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="edad">Edad</label>
                        <input type="number" id="edad" name="edad" min="18" max="100">
                    </div>
                    
                    <div class="form-group">
                        <label for="observaciones">Observaciones</label>
                        <textarea id="observaciones" name="observaciones" placeholder="Alergias, medicamentos, consultas específicas..."></textarea>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="terminos" name="terminos" required>
                            <span class="checkmark"></span>
                            Acepto los <a href="#" target="_blank">términos y condiciones</a>
                        </label>
                    </div>
                </form>

                <div class="step-actions">
                    <button id="prevStep3" class="btn-prev">Anterior</button>
                    <button id="nextStep3" class="btn-next" disabled>Continuar</button>
                </div>
            </div>

            <!-- PASO 4: Confirmación y Pago -->
            <div id="step4" class="step-content">
                <h3>Confirmar reserva</h3>
                
                <!-- Resumen de la reserva -->
                <div class="reserva-summary">
                    <div class="summary-item">
                        <span class="label">Servicio:</span>
                        <span id="summaryService"></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Fecha:</span>
                        <span id="summaryDate"></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Horario:</span>
                        <span id="summaryTime"></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Cliente:</span>
                        <span id="summaryClient"></span>
                    </div>
                    <div class="summary-item total">
                        <span class="label">Total:</span>
                        <span id="summaryTotal"></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Seña (50%):</span>
                        <span id="summaryDeposit"></span>
                    </div>
                </div>

                <!-- Opciones de pago -->
                <div class="payment-options">
                    <h4>Forma de pago de la seña</h4>
                    <div class="payment-methods">
                        <label class="payment-method">
                            <input type="radio" name="paymentMethod" value="mercadopago" checked>
                            <div class="method-card">
                                <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.22.5/mercadopago/logo__large.png" alt="MercadoPago">
                                <span>Tarjeta o Transferencia</span>
                            </div>
                        </label>
                        <label class="payment-method">
                            <input type="radio" name="paymentMethod" value="efectivo">
                            <div class="method-card">
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Efectivo en el local</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="payment-info">
                    <p><i class="fas fa-info-circle"></i> La seña del 50% confirma tu turno. El resto se abona al finalizar el tratamiento.</p>
                </div>

                <div class="step-actions">
                    <button id="prevStep4" class="btn-prev">Anterior</button>
                    <button id="confirmReserva" class="btn-confirm">
                        <i class="fas fa-lock"></i>
                        Confirmar y Pagar
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Loading overlay -->
<div id="loadingOverlay" class="loading-overlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Procesando reserva...</p>
    </div>
</div>

<!-- Success modal -->
<div id="successModal" class="success-modal">
    <div class="success-content">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3>¡Reserva confirmada!</h3>
        <p>Tu turno ha sido reservado exitosamente.</p>
        <div class="success-details">
            <p><strong>Número de reserva:</strong> <span id="reservaNumber"></span></p>
            <p><strong>Te enviaremos:</strong></p>
            <ul>
                <li>Confirmación por email</li>
                <li>Recordatorio por WhatsApp</li>
                <li>Comprobante de pago</li>
            </ul>
        </div>
        <button id="closeSuccess" class="btn-primary">Entendido</button>
    </div>
</div>

<style>
/* ========================================
   SISTEMA DE RESERVAS - ESTILOS
   ======================================== */

.reserva-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 10000;
    backdrop-filter: blur(5px);
}

.reserva-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    border-radius: 20px;
    width: 90%;
    max-width: 900px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.reserva-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem;
    border-bottom: 1px solid #f0f0f0;
    background: linear-gradient(135deg, #FF1493, #FF69B4);
    color: white;
    border-radius: 20px 20px 0 0;
}

.reserva-header h2 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: white;
}

.close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    color: white;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.3s;
}

.close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* Steps indicator */
.reserva-steps {
    display: flex;
    justify-content: space-between;
    padding: 2rem;
    background: #f9f9f9;
}

.step {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #999;
    font-weight: 500;
    position: relative;
}

.step::after {
    content: '';
    position: absolute;
    right: -50%;
    width: 100%;
    height: 2px;
    background: #ddd;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
}

.step:last-child::after {
    display: none;
}

.step.active {
    color: #FF1493;
}

.step.active::after {
    background: #FF1493;
}

.step-number {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ddd;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
    position: relative;
    z-index: 2;
}

.step.active .step-number {
    background: #FF1493;
}

/* Content */
.reserva-content {
    padding: 2rem;
}

.step-content {
    display: none;
}

.step-content.active {
    display: block;
}

.step-content h3 {
    margin-bottom: 1.5rem;
    color: #333;
    font-size: 1.5rem;
}

/* Servicios Grid */
.servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.servicio-card {
    border: 2px solid #f0f0f0;
    border-radius: 15px;
    padding: 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
}

.servicio-card:hover {
    border-color: #FF1493;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 20, 147, 0.15);
}

.servicio-card.selected {
    border-color: #FF1493;
    background: linear-gradient(135deg, #fff0f8, #ffe6f2);
}

.servicio-card h4 {
    color: #333;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
}

.servicio-card .price {
    color: #FF1493;
    font-weight: bold;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

.servicio-card .duration {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
}

.servicio-card .description {
    color: #777;
    font-size: 0.9rem;
    line-height: 1.4;
}

/* Calendar */
.calendar-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.nav-btn {
    background: #FF1493;
    color: white;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    font-size: 1.2rem;
    transition: background 0.3s;
}

.nav-btn:hover {
    background: #e6127f;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: #f0f0f0;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 2rem;
}

.calendar-header {
    background: #FF1493;
    color: white;
    padding: 1rem;
    text-align: center;
    font-weight: bold;
    font-size: 0.9rem;
}

.calendar-day {
    background: white;
    padding: 1rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.calendar-day:hover {
    background: #f8f8f8;
}

.calendar-day.disabled {
    color: #ccc;
    cursor: not-allowed;
    background: #f9f9f9;
}

.calendar-day.selected {
    background: #FF1493;
    color: white;
}

.calendar-day.other-month {
    color: #ccc;
}

/* Time slots */
.time-slots {
    margin-top: 2rem;
}

.slots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.time-slot {
    background: white;
    border: 2px solid #f0f0f0;
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 500;
}

.time-slot:hover {
    border-color: #FF1493;
    background: #fff8fc;
}

.time-slot.selected {
    background: #FF1493;
    color: white;
    border-color: #FF1493;
}

.time-slot.disabled {
    background: #f5f5f5;
    color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
}

/* Form */
.client-form {
    display: grid;
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
}

.form-group input,
.form-group textarea {
    padding: 1rem;
    border: 2px solid #f0f0f0;
    border-radius: 10px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #FF1493;
}

.form-group textarea {
    min-height: 100px;
    resize: vertical;
}

.checkbox-group {
    flex-direction: row;
    align-items: center;
}

.checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 0.9rem;
}

.checkbox-label input[type="checkbox"] {
    margin-right: 0.5rem;
}

/* Summary */
.reserva-summary {
    background: #f9f9f9;
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}

.summary-item {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid #eee;
}

.summary-item:last-child {
    border-bottom: none;
}

.summary-item.total {
    font-weight: bold;
    font-size: 1.1rem;
    color: #FF1493;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid #FF1493;
}

.summary-item .label {
    color: #666;
}

/* Payment */
.payment-methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1rem 0;
}

.payment-method {
    cursor: pointer;
}

.method-card {
    border: 2px solid #f0f0f0;
    border-radius: 15px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.payment-method input:checked + .method-card {
    border-color: #FF1493;
    background: #fff8fc;
}

.method-card img {
    max-width: 120px;
    height: auto;
}

.method-card i {
    font-size: 2rem;
    color: #FF1493;
}

.payment-info {
    background: #e8f4fd;
    border-left: 4px solid #2196F3;
    padding: 1rem;
    border-radius: 5px;
    margin: 1.5rem 0;
}

.payment-info i {
    color: #2196F3;
    margin-right: 0.5rem;
}

/* Actions */
.step-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #f0f0f0;
}

.btn-prev,
.btn-next,
.btn-confirm {
    padding: 1rem 2rem;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-prev {
    background: #f0f0f0;
    color: #666;
}

.btn-prev:hover {
    background: #e0e0e0;
}

.btn-next,
.btn-confirm {
    background: linear-gradient(135deg, #FF1493, #FF69B4);
    color: white;
}

.btn-next:hover,
.btn-confirm:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 20, 147, 0.3);
}

.btn-next:disabled,
.btn-confirm:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

/* Loading & Success */
.loading-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 11000;
    backdrop-filter: blur(5px);
}

.loading-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid rgba(255, 255, 255, 0.3);
    border-top: 5px solid #FF1493;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.success-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 11000;
    backdrop-filter: blur(5px);
}

.success-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    max-width: 500px;
    width: 90%;
}

.success-icon {
    font-size: 4rem;
    color: #4CAF50;
    margin-bottom: 1rem;
}

.success-details {
    background: #f9f9f9;
    border-radius: 10px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    text-align: left;
}

.success-details ul {
    margin-top: 1rem;
    padding-left: 1.5rem;
}

.success-details li {
    margin-bottom: 0.5rem;
}

/* Responsive */
@media (max-width: 768px) {
    .reserva-container {
        width: 95%;
        margin: 1rem;
        max-height: 95vh;
    }
    
    .reserva-header {
        padding: 1.5rem;
    }
    
    .reserva-steps {
        padding: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .reserva-content {
        padding: 1.5rem;
    }
    
    .servicios-grid {
        grid-template-columns: 1fr;
    }
    
    .calendar-grid {
        font-size: 0.9rem;
    }
    
    .calendar-day {
        padding: 0.8rem;
        min-height: 40px;
    }
    
    .slots-grid {
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }
    
    .step-actions {
        flex-direction: column;
        gap: 1rem;
    }
    
    .btn-prev,
    .btn-next,
    .btn-confirm {
        width: 100%;
        justify-content: center;
    }
}
</style>
